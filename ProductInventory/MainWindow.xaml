<Window x:Class="ProductInventory.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mega Stock Spectacular · Product Inventory"
        Width="1300" Height="820" MinWidth="1180" MinHeight="740"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource FlyerYellow}" Foreground="{StaticResource Ink}"
        FontFamily="{StaticResource Heavy}" FontWeight="Black">

    <Window.Resources>
        <DropShadowEffect x:Key="HardShadow" ShadowDepth="4" Direction="315" BlurRadius="0" Color="#111111" Opacity="1" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource SaleRed}" BorderBrush="{StaticResource Ink}" BorderThickness="0,0,0,6"
                Padding="30,10,30,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal" RenderTransformOrigin="0,0.5">
                    <StackPanel.RenderTransform>
                        <RotateTransform Angle="-2" />
                    </StackPanel.RenderTransform>
                    <TextBlock Text="MEGA STOCK" FontFamily="{StaticResource Shout}" FontWeight="Normal" FontSize="70"
                               Foreground="{StaticResource FlyerYellow}" Effect="{StaticResource HardShadow}" />
                    <TextBlock Text="SPECTACULAR!" FontFamily="{StaticResource Shout}" FontWeight="Normal" FontSize="44"
                               Foreground="White" VerticalAlignment="Bottom" Margin="18,0,0,10"
                               Effect="{StaticResource HardShadow}" />
                </StackPanel>
                <Border Background="{StaticResource Ink}" HorizontalAlignment="Left" Padding="12,4" Margin="8,4,0,0"
                        RenderTransformOrigin="0,0.5">
                    <Border.RenderTransform>
                        <RotateTransform Angle="-1" />
                    </Border.RenderTransform>
                    <TextBlock Text="PRODUCT INVENTORY  ·  DICTIONARY&lt;INT, PRODUCT&gt;  ·  ALL PRICES IN RAND, WHILE STOCKS LAST"
                               Foreground="{StaticResource FlyerYellow}" FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="26,20,26,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="318" />
                <ColumnDefinition Width="286" />
            </Grid.ColumnDefinitions>

            <DockPanel Margin="0,0,26,0">
                <Border DockPanel.Dock="Top" Background="{StaticResource Ink}" Padding="14,10,10,10">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="PRICE CHECK" FontFamily="{StaticResource Shout}"
                                   FontWeight="Normal" FontSize="28" Foreground="{StaticResource FlyerYellow}"
                                   VerticalAlignment="Center" Margin="0,0,14,0" />
                        <Button DockPanel.Dock="Right" x:Name="ScanButton" Content="SCAN!" Style="{StaticResource StickerButton}"
                                FontSize="20" Padding="14,1" Margin="12,0,0,-5" Click="ScanButton_Click" />
                        <Grid>
                            <TextBox x:Name="SearchBox" Style="{StaticResource FlyerBox}" KeyDown="SearchBox_KeyDown" />
                            <Rectangle x:Name="Laser" Height="2" Fill="#FF2020" VerticalAlignment="Top" Margin="4,3,4,0"
                                       IsHitTestVisible="False">
                                <Rectangle.RenderTransform>
                                    <TranslateTransform x:Name="LaserShift" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                    </DockPanel>
                </Border>

                <DockPanel DockPanel.Dock="Top" Margin="2,8,0,4">
                    <Button DockPanel.Dock="Right" x:Name="ShowAllButton" Content="SHOW EVERYTHING"
                            Style="{StaticResource ScrawlLink}" Click="ShowAllButton_Click" />
                    <TextBlock x:Name="SearchSummary" FontSize="13" TextTrimming="CharacterEllipsis" />
                </DockPanel>

                <ScrollViewer x:Name="WallScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource FlyerScrollBar}" />
                    </ScrollViewer.Resources>
                    <ItemsControl x:Name="TagWall" Margin="0,6,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid x:Name="Root" Width="162" Height="190" Margin="9,12,15,18" Background="Transparent"
                                      Cursor="Hand" RenderTransformOrigin="0.5,0.5" MouseLeftButtonUp="Tag_MouseLeftButtonUp">
                                    <Grid.RenderTransform>
                                        <RotateTransform Angle="{Binding Angle}" />
                                    </Grid.RenderTransform>
                                    <Border Background="{StaticResource Ink}" Margin="7,7,-7,-7" />
                                    <Border x:Name="Card" Background="White" BorderBrush="{StaticResource Ink}" BorderThickness="3">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Border Background="{StaticResource Ink}" Padding="8,3">
                                                <DockPanel>
                                                    <Ellipse DockPanel.Dock="Right" Width="13" Height="13"
                                                             Fill="{StaticResource FlyerYellow}" Stroke="White" StrokeThickness="2" />
                                                    <TextBlock Text="{Binding IdText}" Foreground="{StaticResource FlyerYellow}"
                                                               FontSize="15" />
                                                </DockPanel>
                                            </Border>
                                            <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="16" TextWrapping="Wrap"
                                                       LineHeight="19" Margin="10,9,10,0" />
                                            <Viewbox Grid.Row="2" StretchDirection="DownOnly" MaxWidth="144"
                                                     HorizontalAlignment="Right" Margin="8,0,10,4">
                                                <StackPanel Orientation="Horizontal" TextElement.FontFamily="{StaticResource Shout}"
                                                            TextElement.FontWeight="Normal"
                                                            TextElement.Foreground="{StaticResource SaleRed}">
                                                    <TextBlock Text="R" FontSize="26" VerticalAlignment="Top" Margin="0,9,2,0" />
                                                    <TextBlock Text="{Binding Rands}" FontSize="60" />
                                                    <TextBlock Text="{Binding Cents}" FontSize="25" VerticalAlignment="Top"
                                                               Margin="2,9,0,0" TextDecorations="Underline" />
                                                </StackPanel>
                                            </Viewbox>
                                        </Grid>
                                    </Border>
                                    <Border x:Name="FoundSticker" Visibility="Collapsed" Background="{StaticResource SaleRed}"
                                            BorderBrush="{StaticResource Ink}" BorderThickness="2" Padding="7,0"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-12,-14,0"
                                            RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <RotateTransform Angle="14" />
                                        </Border.RenderTransform>
                                        <TextBlock Text="FOUND!" FontFamily="{StaticResource Shout}" FontWeight="Normal"
                                                   FontSize="18" Foreground="White" />
                                    </Border>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource SaleRed}" />
                                        <Setter TargetName="Card" Property="BorderThickness" Value="5" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsHit}" Value="True">
                                        <Setter TargetName="Card" Property="Background" Value="{StaticResource HitYellow}" />
                                        <Setter TargetName="FoundSticker" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsDimmed}" Value="True">
                                        <Setter TargetName="Root" Property="Opacity" Value="0.25" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <Grid Grid.Column="1" VerticalAlignment="Top" Margin="0,2,28,0" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <RotateTransform Angle="1.5" />
                </Grid.RenderTransform>
                <Rectangle Fill="White" Stroke="{StaticResource Ink}" StrokeThickness="3" StrokeDashArray="4 2.5" />
                <StackPanel Margin="22,16,22,22">
                    <TextBlock Text="CLIP &amp; SAVE!" FontFamily="{StaticResource Shout}" FontWeight="Normal" FontSize="38"
                               Foreground="{StaticResource SaleRed}" />
                    <TextBlock Text="ADD · UPDATE · DELETE STOCK" FontSize="11" Margin="0,-2,0,4" />

                    <TextBlock Text="PRODUCT ID (THE KEY)" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="IdBox" Style="{StaticResource FlyerBox}" MaxLength="9" />
                    <TextBlock Text="NAME" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="NameBox" Style="{StaticResource FlyerBox}" MaxLength="40" />
                    <TextBlock Text="PRICE (R)" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="PriceBox" Style="{StaticResource FlyerBox}" MaxLength="14" />

                    <Button x:Name="AddButton" Content="ADD TO STOCK!" Style="{StaticResource StickerButton}"
                            FontSize="26" Margin="0,22,0,0" Click="AddButton_Click">
                        <Button.RenderTransform>
                            <RotateTransform Angle="-2" />
                        </Button.RenderTransform>
                    </Button>
                    <UniformGrid Columns="2" Margin="0,12,0,0">
                        <Button x:Name="UpdateButton" Content="UPDATE" Style="{StaticResource StickerButton}"
                                Background="{StaticResource Ink}" Foreground="{StaticResource FlyerYellow}"
                                Padding="8,4" Margin="0,0,8,0" Click="UpdateButton_Click">
                            <Button.RenderTransform>
                                <RotateTransform Angle="2" />
                            </Button.RenderTransform>
                        </Button>
                        <Button x:Name="DeleteButton" Content="DELETE" Style="{StaticResource StickerButton}"
                                Background="White" Foreground="{StaticResource SaleRed}" Padding="8,4" Margin="8,0,0,0"
                                Click="DeleteButton_Click">
                            <Button.RenderTransform>
                                <RotateTransform Angle="-1.5" />
                            </Button.RenderTransform>
                        </Button>
                    </UniformGrid>
                    <Button x:Name="ClearButton" Content="CLEAR COUPON" Style="{StaticResource ScrawlLink}"
                            HorizontalAlignment="Left" Margin="2,16,0,0" Click="ClearButton_Click" />
                    <TextBlock Text="TIP: CLICK ANY PRICE TAG TO FILL THIS IN" FontSize="11" Margin="2,6,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock Text="✂" FontFamily="Segoe UI Symbol" FontWeight="Normal" FontSize="30"
                           Background="{StaticResource FlyerYellow}" HorizontalAlignment="Left" VerticalAlignment="Top"
                           Margin="-12,-22,0,0" />

                <Border x:Name="Sticker" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,-46,-30" Padding="16,4" BorderBrush="{StaticResource Ink}" BorderThickness="3"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="StickerScale" />
                            <RotateTransform Angle="-10" />
                        </TransformGroup>
                    </Border.RenderTransform>
                    <TextBlock x:Name="StickerText" FontFamily="{StaticResource Shout}" FontWeight="Normal" FontSize="32" />
                </Border>
            </Grid>

            <Grid Grid.Column="2" Margin="0,92,0,0" RenderTransformOrigin="0.5,0">
                <Grid.RenderTransform>
                    <RotateTransform Angle="-1.2" />
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="8" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="8" />
                </Grid.RowDefinitions>
                <Border Background="{StaticResource ZigzagUp}" />
                <Border Grid.Row="1" Background="{StaticResource TillPaper}" Padding="14,8,14,10">
                    <DockPanel TextElement.FontFamily="{StaticResource Till}" TextElement.FontWeight="Normal">
                        <StackPanel DockPanel.Dock="Top" TextElement.FontSize="12">
                            <TextBlock Text="*** MEGA STOCK ***" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" />
                            <TextBlock Text="TILL 01 · STOCK ROOM" HorizontalAlignment="Center" />
                            <TextBlock x:Name="TillDate" HorizontalAlignment="Center" />
                            <TextBlock Text="- - - - - - - - - - - - - - - - - -" Foreground="#9A9A9A"
                                       HorizontalAlignment="Center" Margin="0,2,0,4" />
                        </StackPanel>
                        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Ink}" BorderThickness="0,2,0,0"
                                Padding="0,8,0,0" Margin="0,6,0,0">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" x:Name="EnterButton" Content="ENTER"
                                        Style="{StaticResource StickerButton}" FontSize="15" Padding="9,0"
                                        Click="EnterButton_Click" />
                                <TextBlock Text="&gt;" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                                <TextBox x:Name="PromptBox" FontSize="14" FontWeight="Bold" BorderThickness="0"
                                         Background="Transparent" CaretBrush="{StaticResource Ink}" VerticalAlignment="Center"
                                         Margin="4,0,8,0" KeyDown="PromptBox_KeyDown" />
                            </DockPanel>
                        </Border>
                        <ScrollViewer x:Name="TillScroll" VerticalScrollBarVisibility="Hidden">
                            <ItemsControl x:Name="TillLines">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="11.5" TextWrapping="Wrap" Margin="0,1" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
                <Border Grid.Row="2" Background="{StaticResource ZigzagDown}" />
            </Grid>
        </Grid>

        <StackPanel Grid.RowSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,22,36,0">
            <Grid Width="196" Height="196" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <RotateTransform Angle="9" />
                </Grid.RenderTransform>
                <Path x:Name="ValueBurstShadow" Fill="{StaticResource Ink}" Margin="7,7,-7,-7" />
                <Path x:Name="ValueBurst" Fill="{StaticResource FlyerYellow}" Stroke="{StaticResource Ink}" StrokeThickness="3" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="STOCK VALUE" FontSize="13" HorizontalAlignment="Center" />
                    <TextBlock x:Name="ValueText" FontFamily="{StaticResource Shout}" FontWeight="Normal" FontSize="32"
                               Foreground="{StaticResource SaleRed}" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
            <Grid Width="170" Height="170" Margin="-14,46,0,0" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <RotateTransform Angle="-12" />
                </Grid.RenderTransform>
                <Path x:Name="CountBurstShadow" Fill="{StaticResource Ink}" Margin="7,7,-7,-7" />
                <Path x:Name="CountBurst" Fill="White" Stroke="{StaticResource Ink}" StrokeThickness="3" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="CountText" FontFamily="{StaticResource Shout}" FontWeight="Normal" FontSize="54"
                               Foreground="{StaticResource SaleRed}" HorizontalAlignment="Center" />
                    <TextBlock Text="ITEMS!" FontFamily="{StaticResource Shout}" FontWeight="Normal" FontSize="22"
                               HorizontalAlignment="Center" Margin="0,-10,0,0" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
