<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="FlyerYellow" Color="#FFE500" />
    <SolidColorBrush x:Key="SaleRed" Color="#E30613" />
    <SolidColorBrush x:Key="Ink" Color="#111111" />
    <SolidColorBrush x:Key="TillPaper" Color="#FFFDF3" />
    <SolidColorBrush x:Key="HitYellow" Color="#FFF6A8" />

    <FontFamily x:Key="Shout">Impact</FontFamily>
    <FontFamily x:Key="Heavy">Arial</FontFamily>
    <FontFamily x:Key="Till">Consolas</FontFamily>

    <Style x:Key="StickerButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource SaleRed}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontFamily" Value="{StaticResource Shout}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="Padding" Value="18,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Margin="0,0,5,5">
                        <Border Background="{StaticResource Ink}" Margin="5,5,-5,-5" />
                        <Border x:Name="Face" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource Ink}" BorderThickness="3"
                                Padding="{TemplateBinding Padding}">
                            <Border.RenderTransform>
                                <TranslateTransform />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform X="-2" Y="-2" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource SaleRed}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform X="5" Y="5" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrawlLink" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="FontFamily" Value="{StaticResource Heavy}" />
        <Setter Property="FontWeight" Value="Black" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock x:Name="Text" TextDecorations="Underline" Background="Transparent"
                               Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Text" Property="Foreground" Value="{StaticResource SaleRed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FlyerBox" TargetType="TextBox">
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="BorderBrush" Value="{StaticResource Ink}" />
        <Setter Property="BorderThickness" Value="3" />
        <Setter Property="FontFamily" Value="{StaticResource Heavy}" />
        <Setter Property="FontWeight" Value="Black" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="Padding" Value="6,5" />
        <Setter Property="CaretBrush" Value="{StaticResource SaleRed}" />
        <Setter Property="SelectionBrush" Value="{StaticResource SaleRed}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Box" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource SaleRed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Shout}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Margin" Value="0,10,0,3" />
    </Style>

    <Style x:Key="FlyerScrollBar" TargetType="ScrollBar">
        <Setter Property="Width" Value="20" />
        <Setter Property="MinWidth" Value="20" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Border Background="White" BorderBrush="{StaticResource Ink}" BorderThickness="3" Margin="6,0,0,0">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{StaticResource SaleRed}" BorderBrush="{StaticResource Ink}"
                                                    BorderThickness="0,3" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DrawingBrush x:Key="ZigzagDown" TileMode="Tile" Viewport="0,0,14,8" ViewportUnits="Absolute"
                  Viewbox="0,0,14,8" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="#FFFDF3" Geometry="M 0,0 L 14,0 L 7,8 Z" />
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <DrawingBrush x:Key="ZigzagUp" TileMode="Tile" Viewport="0,0,14,8" ViewportUnits="Absolute"
                  Viewbox="0,0,14,8" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="#FFFDF3" Geometry="M 0,8 L 14,8 L 7,0 Z" />
        </DrawingBrush.Drawing>
    </DrawingBrush>

</ResourceDictionary>
